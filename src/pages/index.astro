---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FoxproOverlay from '../components/FoxproOverlay.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const updates = await getCollection('updates', ({ data }) => !data.draft);
const latest = [
  ...posts.map((post) => ({
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    kind: post.data.kind,
    href: `/blog/${post.slug}/`,
  })),
  ...updates.map(({ data }) => data),
].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 7);

const work = [
  {
    title: 'Apple Foundation Models Workbench',
    blurb:
      "Evaluation workbench for Apple's OS 27 on-device and Private Cloud Compute models — runs a prompt repeatedly and scores how often the answer agrees with itself.",
    href: '/projects/#apple-intelligence-foundation-server',
    meta: 'AI tooling · 2026',
  },
  {
    title: '6502 Simulator',
    blurb: 'A 6502 microcomputer with a VIC video chip and a real 6522 VIA timer — runs in your terminal and in your browser, same code.',
    href: '/projects/',
    meta: 'simulator · 2026',
  },
  {
    title: 'Asciimator',
    blurb: 'Browser-based ASCII animation editor built around fast iteration, direct manipulation, and shareable output.',
    href: 'https://asciimator.com',
    meta: 'developer tool · 2026',
  },
];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    // Dates in frontmatter are bare `YYYY-MM-DD`, which parses as UTC
    // midnight. Formatting in the build machine's local zone would render
    // the previous day for anywhere west of Greenwich.
    timeZone: 'UTC',
  });
---

<BaseLayout
  title="Carl Edwards"
  description="Carl Edwards is a product engineering leader and hands-on systems builder. The latest writing, projects, and interactive lessons."
>
  <section class="relative overflow-hidden border-b border-ink-800/80">
    <div class="absolute inset-0 grid-bg opacity-60 pointer-events-none"></div>
    <div class="container-wide relative sm:flex items-start gap-6 py-8 sm:gap-10 sm:py-12">
      <div class="min-w-0 flex-1">
        <div class="text-mono-tag mb-4 min-h-16 pr-20 sm:min-h-0 sm:pr-0">Carl Edwards · Building and leading</div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-ink-100 leading-[1.1] tracking-tight max-w-3xl">
          I build useful software.<br />
          <span class="text-accent">And teams that care about it.</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-ink-300 leading-relaxed max-w-2xl">
          I'm a product engineering leader and hands-on builder. I love listening to
          users, making something we can react to, then learning and iterating together.
        </p>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium">
          <a href="/about/" class="text-ink-200 hover:text-accent">About me →</a>
          <a href="https://linkedin.com/in/the-carl-edwards" class="text-ink-300 hover:text-accent">LinkedIn ↗</a>
        </div>
      </div>
      <img src="/images/avatar.jpg" alt="Carl Edwards" width="112" height="112"
        class="absolute right-6 top-8 sm:static h-16 w-16 sm:h-28 sm:w-28 shrink-0 rounded-full border border-ink-700 object-cover" loading="eager" />
    </div>
  </section>

  <section id="latest" class="container-wide py-10 sm:py-12" aria-labelledby="latest-heading">
    <div class="mb-6 flex flex-wrap items-baseline justify-between gap-4">
      <div>
        <h2 id="latest-heading" class="text-3xl font-semibold tracking-tight text-ink-100">Latest</h2>
        <p class="mt-2 text-ink-400">What I'm building, sharing, and thinking about.</p>
      </div>
      <a href="/rss.xml" class="text-sm text-ink-400 hover:text-accent">Subscribe via RSS →</a>
    </div>
    <ul class="divide-y divide-ink-800 border-y border-ink-800">
      {latest.map((item) => (
        <li>
          <a href={item.href} class="group grid gap-3 py-6 sm:grid-cols-[140px_minmax(0,1fr)] sm:gap-6">
            <div class="flex items-center gap-3 sm:block">
              <span class="inline-block rounded bg-ink-800/60 px-2 py-1 font-mono text-[10px] uppercase tracking-wider text-accent">{item.kind}</span>
              <time class="block font-mono text-xs text-ink-500 sm:mt-3" datetime={item.date.toISOString()}>{fmt(item.date)}</time>
            </div>
            <div class="min-w-0">
              <h3 class="text-lg sm:text-xl font-medium tracking-tight text-ink-100 group-hover:text-accent">{item.title}</h3>
              {item.description && <p class="mt-2 max-w-3xl text-sm sm:text-base text-ink-400 leading-relaxed">{item.description}</p>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <nav aria-label="Explore more" class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm text-ink-300">
      <a href="/blog/" class="hover:text-accent">All writing →</a>
      <a href="/projects/" class="hover:text-accent">All projects →</a>
      <a href="/learn/" class="hover:text-accent">Explore the lessons →</a>
    </nav>
  </section>

  <section class="container-wide py-10 border-t border-ink-800/80" aria-labelledby="selected-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-4 mb-6">
      <h2 id="selected-heading" class="text-2xl font-semibold tracking-tight text-ink-100">Selected work</h2>
      <a href="/projects/" class="text-sm text-ink-400 hover:text-accent">All projects →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {work.map((w) => (
        <a href={w.href} class="group block rounded-lg border border-ink-800 bg-ink-900 p-6 hover:border-ink-600 hover:bg-ink-800/60">
          <div class="font-mono text-xs uppercase tracking-wider text-ink-400">{w.meta}</div>
          <h3 class="mt-3 text-lg font-semibold text-ink-100 group-hover:text-accent">{w.title}</h3>
          <p class="mt-2 text-sm text-ink-300 leading-relaxed">{w.blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="container-wide py-10 sm:py-12 border-t border-ink-800/80">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-tight text-ink-100">Customer experience first.</h2>
      <p class="mt-3 text-ink-300 leading-relaxed">
        From BASIC and 6502 assembly to engineering leadership, I've learned by building
        with people. I care about making technology useful and leaving the product
        better than we found it.
      </p>
      <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium">
        <a href="/about/" class="text-ink-200 hover:text-accent">More about me →</a>
        <a href="/about/#contact" class="text-ink-200 hover:text-accent">Get in touch →</a>
      </div>
    </div>
  </section>
  <FoxproOverlay slot="overlays" />
</BaseLayout>
