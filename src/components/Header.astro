---
const { pathname } = Astro.url;
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/learn/', label: 'Learn' },
  { href: '/blog/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="border-b border-ink-800/80 bg-ink-950/70 backdrop-blur-md sticky top-0 z-40">
  {/* Two rows on phones, one row from `sm` up. The 5 links plus the theme
      toggle physically cannot fit beside the wordmark in a single 64px row at
      phone widths — they used to overflow past the viewport, and because
      `html,body { overflow-x: clip }` they could not be scrolled to, leaving
      About and the toggle unreachable on mobile.

      Grid + `order` rather than two markup blocks, so there is still exactly
      one toggle button for the script below to bind to:
        mobile  — brand | toggle   (row 1), nav spanning both cols (row 2)
        sm and up — brand | nav | toggle, all on one row. */}
  <div
    class="container-wide grid grid-cols-[1fr_auto] items-center gap-x-4 py-2 sm:h-16 sm:grid-cols-[auto_1fr_auto] sm:py-0"
  >
    <a href="/" class="group order-1 flex h-10 items-center gap-3 font-mono text-sm sm:h-auto">
      <span class="inline-block h-2 w-2 rounded-full bg-status shadow-[0_0_12px_rgb(var(--status))]"></span>
      <span class="text-ink-100 group-hover:text-accent">
        Carl<span class="hidden sm:inline"> Edwards</span>
      </span>
    </a>
    <nav
      class="order-3 col-span-2 -ml-2.5 flex flex-wrap items-center gap-x-0.5 gap-y-1 pb-1 sm:order-2 sm:col-span-1 sm:-ml-0 sm:gap-x-1 sm:justify-end sm:pb-0"
    >
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={isActive(l.href) ? (pathname === l.href ? 'page' : 'location') : undefined}
          class:list={[
            'px-2.5 py-1.5 rounded-md text-sm font-medium sm:px-3',
            isActive(l.href)
              ? 'text-ink-100 bg-ink-800/60'
              : 'text-ink-400 hover:text-ink-100 hover:bg-ink-800/40',
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle light/dark theme"
      title="Toggle light/dark theme"
      class="order-2 inline-flex h-8 w-8 items-center justify-center justify-self-end rounded-md text-ink-400 hover:bg-ink-800/40 hover:text-ink-100 sm:order-3 sm:ml-1"
    >
      <svg
        class="theme-ico-sun h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4" />
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
        />
      </svg>
      <svg
        class="theme-ico-moon h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var light = document.documentElement.classList.toggle('light');
      try {
        localStorage.setItem('theme', light ? 'light' : 'dark');
      } catch (e) {}
    });
  })();
</script>
